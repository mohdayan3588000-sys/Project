#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Song {
    char name[50];
    char artist[50];
    struct Song *next;
};

struct Song *head = NULL;

// Add a song
void addSong() {
    struct Song *newSong, *temp;

    newSong = (struct Song *)malloc(sizeof(struct Song));

    printf("Enter Song Name: ");
    scanf(" %[^\n]", newSong->name);

    printf("Enter Artist Name: ");
    scanf(" %[^\n]", newSong->artist);

    newSong->next = NULL;

    if (head == NULL) {
        head = newSong;
    } else {
        temp = head;
        while (temp->next != NULL)
            temp = temp->next;

        temp->next = newSong;
    }

    printf("Song added successfully!\n");
}

// Display playlist
void displaySongs() {
    struct Song *temp = head;

    if (head == NULL) {
        printf("Playlist is empty.\n");
        return;
    }

    printf("\n--- Music Playlist ---\n");

    while (temp != NULL) {
        printf("Song: %s | Artist: %s\n",
               temp->name, temp->artist);
        temp = temp->next;
    }
}

// Search a song
void searchSong() {
    char name[50];
    struct Song *temp = head;

    printf("Enter song name to search: ");
    scanf(" %[^\n]", name);

    while (temp != NULL) {
        if (strcmp(temp->name, name) == 0) {
            printf("Song Found: %s by %s\n",
                   temp->name, temp->artist);
            return;
        }
        temp = temp->next;
    }

    printf("Song not found.\n");
}

// Delete a song
void deleteSong() {
    char name[50];
    struct Song *temp = head, *prev = NULL;

    printf("Enter song name to delete: ");
    scanf(" %[^\n]", name);

    while (temp != NULL) {
        if (strcmp(temp->name, name) == 0) {
            if (prev == NULL)
                head = temp->next;
            else
                prev->next = temp->next;

            free(temp);
            printf("Song deleted successfully!\n");
            return;
        }

        prev = temp;
        temp = temp->next;
    }

    printf("Song not found.\n");
}

int main() {
    int choice;

    while (1) {
        printf("\n===== Music Playlist Management =====\n");
        printf("1. Add Song\n");
        printf("2. Display Playlist\n");
        printf("3. Search Song\n");
        printf("4. Delete Song\n");
        printf("5. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                addSong();
                break;

            case 2:
                displaySongs();
                break;

            case 3:
                searchSong();
                break;

            case 4:
                deleteSong();
                break;

            case 5:
                exit(0);

            default:
                printf("Invalid choice!\n");
        }
    }

    return 0;
}
